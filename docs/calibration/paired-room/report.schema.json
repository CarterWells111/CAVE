{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neijiecave.com/schemas/paired-report-v0.1.json",
  "title": "Paired scenario report calibration draft",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "scenarioId", "status", "commonGround", "differences", "advice", "togetherNextSteps", "uncertainties"],
      "properties": {
        "version": { "const": "paired-report-v0.1" },
        "scenarioId": { "$ref": "#/$defs/scenarioId" },
        "status": { "const": "ready" },
        "commonGround": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/observation" } },
        "differences": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/observation" } },
        "advice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B"],
          "properties": {
            "A": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/advice" } },
            "B": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/advice" } }
          }
        },
        "togetherNextSteps": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/groundedText" } },
        "uncertainties": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/groundedText" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "scenarioId", "status", "message"],
      "properties": {
        "version": { "const": "paired-report-v0.1" },
        "scenarioId": { "$ref": "#/$defs/scenarioId" },
        "status": { "const": "paused" },
        "message": { "const": "这次暂不生成共同报告。请先在各自安全、自在的条件下决定是否继续使用；不需要为了完成报告而继续讨论。" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "scenarioId", "status", "message"],
      "properties": {
        "version": { "const": "paired-report-v0.1" },
        "scenarioId": { "$ref": "#/$defs/scenarioId" },
        "status": { "const": "insufficient" },
        "message": { "const": "目前没有足够的双方信息生成有依据的共同报告。可以各自补充、跳过，或结束本次填写。" }
      }
    }
  ],
  "$defs": {
    "scenarioId": { "enum": ["first-overnight", "pause", "adjust"] },
    "answerId": { "type": "string", "pattern": "^[AB]\\.(expectation|concern|boundary|response_next_step)$" },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/answerId" } },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 80 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "groundedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 60 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["say", "do", "evidence"],
      "properties": {
        "say": { "type": "string", "minLength": 1, "maxLength": 60 },
        "do": { "type": "string", "minLength": 1, "maxLength": 60 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  }
}
