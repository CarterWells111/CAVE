{
  "name": "@cave/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "start:acceptance": "node ../../scripts/start-acceptance.mjs",
    "routes:generate": "node ../../scripts/generate-mobile-routes.mjs",
    "typecheck": "pnpm routes:generate && tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "expo:doctor": "expo-doctor",
    "export:ios": "expo export --platform ios --output-dir dist",
    "export:acceptance": "node ../../scripts/export-acceptance.mjs"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@cave/content": "workspace:*",
    "@cave/contracts": "workspace:*",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.20",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.4",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-view-shot": "5.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@expo/router-server": "~57.0.9",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "~24.13.3",
    "@types/react": "~19.2.18",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.3",
    "expo-server": "~57.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ]
  }
}
