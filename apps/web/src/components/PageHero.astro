---
type Props = {
  eyebrow: string;
  title: string;
  description: string;
  notice?: string;
  headingId?: string;
};

const { eyebrow, title, description, notice, headingId } = Astro.props;
---

<header class="page-hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1 id={headingId}>{title}</h1>
  <p class="page-hero__description">{description}</p>
  {notice && <p class="adult-notice">{notice}</p>}
</header>
