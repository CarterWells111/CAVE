---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const description = "这个页面不存在或已经移动。返回 CAVE 内界首页，或前往支持页面继续查找。";
---

<BaseLayout
  title="页面不存在｜CAVE 内界"
  description={description}
  path="/404"
  robots="noindex"
>
  <section class="section page-section">
    <PageHero
      eyebrow="404"
      title="页面不存在"
      description="你访问的地址可能已更改，或原本就不存在。"
      headingId="not-found-title"
    />

    <aside class="callout" aria-labelledby="not-found-next-title">
      <h2 id="not-found-next-title">从这里继续</h2>
      <p>
        <a class="text-link" href="/">返回首页</a>
        <span aria-hidden="true"> · </span>
        <a class="text-link" href="/support/">前往支持</a>
      </p>
    </aside>
  </section>
</BaseLayout>
