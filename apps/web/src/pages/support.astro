---
import PageHero from "../components/PageHero.astro";
import { site, supportFaq } from "../content/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="使用支持｜CAVE 内界"
  description="查看 CAVE 的账号、本机数据、沟通草稿、删除和成年人使用说明，并通过邮件联系支持。"
  path="/support/"
>
  <section class="section page-section">
    <PageHero
      eyebrow="Support"
      title="使用支持"
      description="先从常见问题开始；如果仍需要帮助，可以通过邮件联系我们。"
    />

    <div class="faq-list" aria-label="常见问题">
      {supportFaq.map(([question, answer]) => (
        <details data-faq>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>

    <aside class="callout" aria-labelledby="contact-title">
      <h2 id="contact-title">联系支持</h2>
      <p><a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a></p>
      <p>{site.supportEmail} 不是紧急服务，也不提供医疗诊断、法律代理或危机干预。</p>
    </aside>
  </section>
</BaseLayout>
