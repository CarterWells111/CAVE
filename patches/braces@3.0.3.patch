--- /dev/null
+++ b/lib/depth-limit.js
@@ -0,0 +1,8 @@
+'use strict';
+
+// Bound both parsed patterns and caller-supplied AST recursion.
+module.exports = depth => {
+  if (depth > 128) {
+    throw new SyntaxError('braces nesting depth exceeds 128');
+  }
+};
