{
  "name": "body-voice-hackathon",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @hackathon/mobile start",
    "dev:gateway": "pnpm --filter @hackathon/gateway dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build:gateway": "pnpm --filter @hackathon/gateway build",
    "verify:foundation": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:gateway"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.18"
  }
}
